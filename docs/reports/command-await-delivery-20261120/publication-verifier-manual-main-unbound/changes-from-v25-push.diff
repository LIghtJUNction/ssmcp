+        logs["publish_release"], number=5, occurrence=0, total=2, artifacts=release_artifacts,
+        run=run, path="dist", next_header=DOWNLOAD, next_number=6, next_name="Run " + DOWNLOAD))
+    consumed.append(download_output(
