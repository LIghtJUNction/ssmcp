  "behavior_from_source": [
    {
      "topic": "Query-specific directory completion",
      "observation": "A nonempty explicit query that misses the local directory now waits for the associated List request. The waiter is bound to the messaging connection; an unrelated response does not complete it. Valid exact recipient syntax matches the exact recipient ID rather than a display name.",
      "files": [
        "src/client/messaging.rs",
        "src/client/terminal/conversation/messaging.rs"
      ]
    },
    {
      "topic": "Bounded confirmation of a pre-query miss",
      "observation": "If the lookup joined a List that already existed before the query and its result misses, one post-query List is reused or started. The confirmation lookup has no further confirmation token. A fresh miss ends the lookup; no concurrent duplicate refresh is added for that confirmation.",
      "maximum_query_associated_fresh_confirmations": 1,
      "files": [
        "src/client/messaging.rs",
        "src/client/terminal/conversation/messaging.rs"
      ]
    },
    {
      "topic": "Cancellation and draft ownership",
      "observation": "Pending lookup requires the original InputStamp, history owner, content focus and eligible UI state. Keyboard bytes cancel before decoding, including an Escape prefix; editing, submit, recipient change, canvas restore, navigation and layout change cancel pending lookup. A late result must not replace a newer draft or reopen the picker.",
      "files": [
        "src/client/terminal.rs",
        "src/client/terminal/conversation.rs",
        "src/client/terminal/conversation/canvas.rs",
        "src/client/terminal/conversation/messaging.rs"
      ]
    },
    {
      "topic": "Highlighting is separate from selecting and sending",
      "observation": "Successful lookup highlights the verified recipient's actual merged row. It does not automatically select the recipient or send a message. Only the still-matching explicit command is cleared on successful completion; failure retains the draft.",
      "files": [
        "src/client/terminal/conversation/messaging.rs",
        "src/client/terminal/conversation.rs"
      ]
    },
    {
      "topic": "Unchanged empty-query limit",
      "observation": "An empty query with an empty directory still requests a refresh and returns the existing retry notice. This source change is not a claim that an empty /message now waits asynchronously.",
      "files": [
        "src/client/terminal/conversation/messaging.rs"
      ]
    }
  ],
