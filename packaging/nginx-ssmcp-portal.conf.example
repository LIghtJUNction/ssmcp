# Include in nginx's http context. Run the account portal with --portal-only
# on 127.0.0.1:8086; keep the SSH/MCP gateway on 127.0.0.1:8080.
# Replace the domain and certificate paths. Access logs exclude query strings,
# credentials, Authorization headers and bodies.
log_format ssmcp_portal_safe '$time_iso8601 request_id=$upstream_http_x_request_id '
    'method=$request_method uri=$uri status=$status duration=$request_time';
map $http_upgrade $ssmcp_portal_connection { default upgrade; '' ''; }
map $arg_state $ssmcp_github_backend {
    default 127.0.0.1:8080;
    "~^portal_[A-Za-z0-9_-]{43}$" 127.0.0.1:8086;
}
server {
    listen 443 ssl;
    server_name ssmcp.example.com;
    ssl_certificate /etc/letsencrypt/live/ssmcp.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ssmcp.example.com/privkey.pem;
    access_log /var/log/nginx/ssmcp-access.log ssmcp_portal_safe;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $ssmcp_portal_connection;
    proxy_connect_timeout 5s;
    proxy_send_timeout 930s;
    proxy_read_timeout 930s;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_intercept_errors on;
    error_page 504 = @ssmcp_timeout;

    location = / { proxy_pass http://127.0.0.1:8086; }
    location = /portal.css { proxy_pass http://127.0.0.1:8086; }
    location ^~ /guide/ {
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_pass http://127.0.0.1:8086;
    }
    location ^~ /account/ {
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_pass http://127.0.0.1:8086;
    }
    location = /setup {
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_pass http://127.0.0.1:8086;
    }
    location ^~ /setup/ {
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_pass http://127.0.0.1:8086;
    }
    location ^~ /api/setup/ {
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_pass http://127.0.0.1:8086;
    }
    location = /oauth/callback/github {
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_pass http://$ssmcp_github_backend;
    }
    location ~ ^/(oauth/|\.well-known/|healthz$) {
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_pass http://127.0.0.1:8080;
    }
    location / { proxy_pass http://127.0.0.1:8080; }
    location @ssmcp_timeout {
        default_type application/json;
        return 504 '{"error":"upstream_timeout","message":"Inspect the existing job before retrying a mutating call."}';
    }
}
