pkgname=ssmcp-git
pkgver=0.9.0.r0
pkgrel=1
pkgdesc='Bridge native local tools and concurrent shell tasks to MCP over SSH'
arch=('x86_64' 'aarch64')
url='https://github.com/LIghtJUNction/ssmcp'
license=('MIT')
depends=('gcc-libs' 'glibc' 'nodejs>=18' 'bubblewrap>=0.8' 'util-linux' 'git')
makedepends=('git' 'rust' 'cargo')
checkdepends=('python' 'rsync')
optdepends=('rsync: synchronize workspace directory contents'
            'python: server setup helper')
provides=('ssmcp')
conflicts=('ssmcp')
backup=('etc/ssmcpd/ssmcpd.env')
source=('ssmcp::git+https://github.com/LIghtJUNction/ssmcp.git')
sha256sums=('SKIP')

pkgver() {
 cd "$srcdir/ssmcp"
 printf '%s.r%s.g%s' "$(sed -n 's/^version = "\([^"]*\)"/\1/p' Cargo.toml | head -1)" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
 cd "$srcdir/ssmcp"
 RUSTUP_TOOLCHAIN=stable cargo build --locked --release
}

check() {
 cd "$srcdir/ssmcp"
 RUSTUP_TOOLCHAIN=stable cargo test --locked
}

package() {
 cd "$srcdir/ssmcp"
 make install-server install-portal DESTDIR="$pkgdir" PREFIX=/usr
 install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
 install -Dm644 /dev/stdin "$pkgdir/usr/lib/sysusers.d/ssmcp.conf" <<'SYSUSERS'
g ssmcp -
u ssmcpd -:ssmcp "SSH terminal MCP gateway" /nonexistent /usr/bin/nologin
SYSUSERS
}
