[Unit]
Description=SSH terminal MCP gateway
After=network.target

[Service]
Type=simple
User=ssmcpd
Group=ssmcp
StateDirectory=ssmcpd
StateDirectoryMode=0700
EnvironmentFile=-/etc/ssmcpd/ssmcpd.env
ExecStart=/usr/local/bin/ssmcpd serve
RuntimeDirectory=ssmcpd
RuntimeDirectoryMode=0750
UMask=0007
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
# bubblewrap sets this namespace's limits before disabling nested user namespaces.
# Keep namespace-aware directory lookup instead of binding a single sysctl file.
ReadWritePaths=/proc/sys/user
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
