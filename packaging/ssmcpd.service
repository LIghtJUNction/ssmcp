[Unit]
Description=SSH terminal MCP gateway
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
DynamicUser=no
User=ssmcpd
Group=ssmcp
StateDirectory=ssmcpd
StateDirectoryMode=0700
EnvironmentFile=-/etc/ssmcpd/ssmcpd.env
ExecStart=/usr/local/bin/ssmcpd serve
RuntimeDirectory=ssmcpd
RuntimeDirectoryMode=0750
UMask=0077
Restart=always
RestartSec=2
TimeoutStopSec=20
CacheDirectory=ssmcpd
CacheDirectoryMode=0700
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ssmcpd
Environment=RUST_LOG=info
LogRateLimitIntervalSec=30s
LogRateLimitBurst=1000
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
# bubblewrap sets this namespace's limits before disabling nested user namespaces.
# Keep namespace-aware directory lookup instead of binding a single sysctl file.
ReadWritePaths=/proc/sys/user
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
