# Include in nginx's http context. Replace the domain and TLS certificate paths.
# No query strings, tokens, Authorization headers or bodies enter this access log.
log_format ssmcp_safe '$time_iso8601 request_id=$upstream_http_x_request_id '
    'method=$request_method uri=$uri status=$status duration=$request_time';
map $http_upgrade $ssmcp_upgrade_connection { default upgrade; '' ''; }
server {
    listen 443 ssl;
    server_name ssmcp.example.com;
    ssl_certificate /etc/letsencrypt/live/ssmcp.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ssmcp.example.com/privkey.pem;
    access_log /var/log/nginx/ssmcp-access.log ssmcp_safe;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $ssmcp_upgrade_connection;
    proxy_connect_timeout 5s;
    proxy_send_timeout 930s;
    proxy_read_timeout 930s;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_intercept_errors on;
    error_page 504 = @ssmcp_timeout;
    location ~ ^/(oauth/|account/|guide/|\.well-known/|healthz$) {
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_pass http://127.0.0.1:8080;
    }
    location / { proxy_pass http://127.0.0.1:8080; }
    location @ssmcp_timeout {
        default_type application/json;
        return 504 '{"error":"upstream_timeout","message":"Inspect the existing job before retrying a mutating call."}';
    }
}
