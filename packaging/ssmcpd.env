# Optional compatibility environment file. Prefer /etc/ssmcpd/ssmcpd.toml.
# Active environment values override TOML; command-line options override both.
# Existing installations keep their original file during make install-server.
# SSMCP_CONFIG=/etc/ssmcpd/ssmcpd.toml
# SSMCP_LISTEN=127.0.0.1:8080
# SSMCP_PUBLIC_URL=https://ssmcp.example.com
# SSMCP_ACCESS_TOKEN_TTL=28800
# SSMCP_REFRESH_TOKEN_IDLE_TTL=2592000
# SSMCP_REFRESH_TOKEN_MAX_TTL=7776000
# SSMCP_CLIENT_REGISTRATION_TTL=31536000
