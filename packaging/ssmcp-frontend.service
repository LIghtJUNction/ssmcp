[Unit]
Description=SSMCP public guide and asset renderer
After=local-fs.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=ssmcpd
Group=ssmcp
ExecStart=/usr/local/bin/ssmcp-frontend --socket /run/ssmcp-frontend/render.sock
RuntimeDirectory=ssmcp-frontend
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ssmcp-frontend
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
InaccessiblePaths=-/var/lib/ssmcpd -/etc/ssmcpd

[Install]
WantedBy=multi-user.target
